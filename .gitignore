# Native launcher binary (rebuilt from source by make/build scripts)
/splash/launcher

# Bundled Deno JS runtime (downloaded by build scripts, ~90 MB)
/deno/

# ============================================================================
# Release artifacts - distributed via GitHub Releases, never committed
# ============================================================================
*.deb
*.rpm
*.dmg
*.exe
*.msi
*.app
*.AppImage
*.zip
*.tar
*.tar.gz

# ============================================================================
# Logs & runtime data
# ============================================================================
*.log
logs/
*.sqlite3
*.db

# ============================================================================
# User data / secrets - personal, never commit them
# ============================================================================
cookies.txt
*.txt.metadata
*netscape*
/*.uuid.txt
[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*.txt

